# Copie para .env SOMENTE para desenvolvimento local.
# Na Netlify, configure as variáveis no painel: Site settings > Environment variables.

# Token de integração da Pushin Pay (https://app.pushinpay.com.br)
# Com ele, a divulgação é cobrada via PIX de verdade. Sem ele, o site roda em modo demonstração.
PUSHIN_PAY_TOKEN=70255|...

# Base da API (produção). Só altere para usar o sandbox.
PUSHIN_PAY_BASE_URL=https://api.pushinpay.com.br/api

# URL do webhook que a Pushin Pay chama ao mudar o status do PIX (opcional).
# Em produção na Netlify, é derivada automaticamente de process.env.URL; não precisa definir.
# PUSHIN_PAY_WEBHOOK_URL=https://seusite.netlify.app/api/webhook/pushin

# Porta da API (apenas desenvolvimento local)
PORT=3001
