# Copie este arquivo para .env e preencha com suas credenciais reais da SedePay.
# A chave deve existir apenas no backend (variável de ambiente). Nunca exponha no frontend/repositório.

# Chave de API da SedePay (menu "API e chaves" do painel)
SEDEPAY_API_KEY=sk_live_SUA_CHAVE

# Secret do webhook (whsec_...) gerado no painel SedePay
SEDEPAY_WEBHOOK_SECRET=whsec_SUA_CHAVE

# Porta da API
PORT=3001

# Carteira TRC20 fixa para receber doações em USDT
USDT_WALLET_ADDRESS=TKQexemploDeCarteiraTRC20mrx5L
