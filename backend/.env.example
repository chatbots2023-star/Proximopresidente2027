# Copie este arquivo para .env SOMENTE para desenvolvimento local.
# Na Netlify, configure as variáveis no painel: Site settings > Environment variables.

# Token de API da Pepper (Painel Pepper > Configurações > API > Copiar token)
PEPPER_API_TOKEN=seu_token_da_pepper_aqui

# Porta da API (apenas desenvolvimento local)
PORT=3001
