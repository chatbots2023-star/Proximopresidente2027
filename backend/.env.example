# Copie para .env SOMENTE para desenvolvimento local.
# Na Netlify, configure as variáveis no painel: Site settings > Environment variables.

# Chave secreta da Stripe (live: https://dashboard.stripe.com/apikeys)
# Com ela, PIX e Cartão são cobrados de verdade. Sem ela, o site roda em modo demonstração.
STRIPE_SECRET_KEY=sk_live_...

# Chave pública da Stripe (live) — usada pelo navegador para renderizar o cartão.
# A mesma deve ir para frontend/.env como VITE_STRIPE_PUBLISHABLE_KEY e na Netlify.
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Endereço USDT (TRON / TRC20) para divulgações pagas em cripto
USDT_WALLET_ADDRESS=TKrHKch9gjZwmcmLF3CiAgNVHh2i9mrx5L

# Porta da API (apenas desenvolvimento local)
PORT=3001
